---
import "@fontsource-variable/inter";
import "@fontsource/instrument-serif/400-italic.css";
import "@fontsource/geist-mono/400.css";
import "../styles/global.css";
import { Picture, getImage } from "astro:assets";
import mountain from "../assets/hero/mountain.jpg";

const blurTwin = await getImage({
  src: mountain,
  width: 900,
  format: "jpg",
  quality: 55,
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>OG card</title>
  </head>
  <body>
    <div
      data-og-card
      class="og-card"
      style={`--hero-img: url(${blurTwin.src})`}
    >
      <div class="bgblur" aria-hidden="true"></div>
      <div class="photo-wrap">
        <Picture
          class="photo"
          src={mountain}
          widths={[900, 1200]}
          formats={["jpeg"]}
          sizes="60vw"
          alt=""
          width={1200}
          height={1600}
          loading="eager"
        />
      </div>
      <div class="fadeout" aria-hidden="true"></div>
      <div class="glass">
        <i class="corner tl" aria-hidden="true"></i>
        <i class="corner tr" aria-hidden="true"></i>
        <i class="corner bl" aria-hidden="true"></i>
        <i class="corner br" aria-hidden="true"></i>
        <p class="eyebrow m">TRAILHEAD · SOFTWARE ENGINEER</p>
        <h1>
          <span>I don't write code.</span>
          <span class="serif">I build what</span>
          <span>writes it.</span>
        </h1>
        <p class="domain m">ethanflow.dev</p>
      </div>
    </div>
  </body>
</html>

<style is:global>
  body {
    margin: 0;
    padding: 0;
    background: var(--surface-page);
  }

  .m {
    font-family: var(--font-mono);
  }
</style>

<style>
  .og-card {
    position: relative;
    width: 1200px;
    height: 630px;
    overflow: hidden;
    color: var(--hero-ink);
    background: var(--surface-page);
  }

  .bgblur {
    position: absolute;
    inset: -40px;
    background: var(--hero-img) 30% 40% / cover no-repeat;
    filter: blur(38px) saturate(1.35) brightness(1.05);
    transform: scale(1.12);
  }

  .photo-wrap {
    position: absolute;
    top: -16px;
    bottom: -16px;
    right: -16px;
    width: 58%;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 28%);
    mask-image: linear-gradient(90deg, transparent 0%, #000 28%);
  }

  .photo-wrap :global(img),
  .photo-wrap :global(picture) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 52%;
  }

  .fadeout {
    position: absolute;
    inset: auto 0 0;
    height: 100px;
    background: linear-gradient(transparent, var(--surface-page));
    pointer-events: none;
  }

  .glass {
    position: absolute;
    z-index: 2;
    left: 48px;
    top: 50%;
    transform: translateY(-50%);
    width: 520px;
    padding: 36px 32px 32px;
    background: linear-gradient(
      140deg,
      var(--hero-glass-high),
      var(--hero-glass-low) 55%,
      var(--hero-glass-mid)
    );
    -webkit-backdrop-filter: blur(22px) saturate(1.5);
    backdrop-filter: blur(22px) saturate(1.5);
    border: var(--size-hairline) solid var(--hero-glass-edge);
    box-shadow:
      inset 0 1px 0 var(--hero-glass-highlight),
      0 30px 80px var(--hero-shadow);
  }

  .corner {
    position: absolute;
    width: var(--size-bracket);
    height: var(--size-bracket);
    border-color: var(--hero-bracket);
    border-style: solid;
  }

  .tl {
    top: 8px;
    left: 8px;
    border-width: var(--size-hairline) 0 0 var(--size-hairline);
  }
  .tr {
    top: 8px;
    right: 8px;
    border-width: var(--size-hairline) var(--size-hairline) 0 0;
  }
  .bl {
    bottom: 8px;
    left: 8px;
    border-width: 0 0 var(--size-hairline) var(--size-hairline);
  }
  .br {
    bottom: 8px;
    right: 8px;
    border-width: 0 var(--size-hairline) var(--size-hairline) 0;
  }

  .eyebrow {
    font-size: 11px;
    letter-spacing: 0.16em;
    color: var(--hero-label);
    margin: 0;
  }

  h1 {
    font-weight: 800;
    font-size: 52px;
    line-height: 0.94;
    letter-spacing: -0.05em;
    color: var(--hero-ink);
    margin: 14px 0 18px;
  }

  h1 .serif {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    font-size: 56px;
    color: var(--hero-serif);
    letter-spacing: -0.02em;
  }

  h1 span {
    display: block;
  }

  .domain {
    margin: 0;
    padding-top: 16px;
    border-top: var(--size-hairline) solid var(--hero-rule);
    font-size: 12px;
    letter-spacing: 0.14em;
    color: var(--hero-label);
    text-transform: lowercase;
  }
</style>
