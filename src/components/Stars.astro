---
// The night sky toward the bottom of the page: small cream specks that twinkle, as in the Camp
// section of the approved mock. They fade in as you arrive at Camp and stay through the
// register and footer. Built for phones: three tiled layers fixed to the viewport, each fading on its
// own slow timer, and one scroll-linked opacity on the wrapper (all composited, no repaint), instead
// of hundreds of individually animated dots. Positions are fixed at build time (seeded).

function seeded(seed: number) {
  let s = seed;
  return () => {
    s = (s * 1664525 + 1013904223) % 4294967296;
    return s / 4294967296;
  };
}

/** One tile of `count` 2px specks, as a CSS background image list. */
function layer(seed: number, count: number, w: number, h: number) {
  const rnd = seeded(seed);
  const dots = Array.from({ length: count }, () => {
    const x = Math.round(rnd() * w);
    const y = Math.round(rnd() * h);
    // A crisp ~2px speck like the original mock (2px squares); a few slightly larger.
    const r = rnd() < 0.25 ? 1.6 : 1.2;
    return `radial-gradient(circle at ${x}px ${y}px, var(--palette-cream) ${r}px, transparent ${r + 0.3}px)`;
  });
  return { image: dots.join(", "), size: `${w}px ${h}px` };
}

// Different tile sizes so the repeat is never obvious.
const layers = [layer(7, 5, 271, 331), layer(19, 6, 389, 443), layer(43, 7, 523, 601)];
---

<div class="stars" aria-hidden="true">
  {layers.map((l) => <i style={`background-image: ${l.image}; background-size: ${l.size};`}></i>)}
</div>

<script>
  // Fade the sky in as you arrive at Camp: from Camp's top reaching mid-screen until a fifth of
  // the way through it (nothing over "The trail so far").
  const sky = document.querySelector<HTMLElement>(".stars");
  const camp = document.getElementById("camp");
  if (sky && camp) {
    let queued = false;
    const update = () => {
      queued = false;
      const top = camp.getBoundingClientRect().top;
      const start = window.innerHeight * 0.5; // Camp's top at mid-screen
      const end = -camp.offsetHeight * 0.2; // a fifth of Camp scrolled past
      const t = Math.min(1, Math.max(0, (start - top) / (start - end)));
      sky.style.opacity = t.toFixed(3);
    };
    const queue = () => {
      if (!queued) {
        queued = true;
        requestAnimationFrame(update);
      }
    };
    window.addEventListener("scroll", queue, { passive: true });
    window.addEventListener("resize", queue);
    update();
  }
</script>

<style>
  .stars {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    /* Hidden until the script fades it in near the bottom of the page. */
    opacity: 0;
    will-change: opacity;
  }

  .stars i {
    position: absolute;
    inset: 0;
    background-repeat: repeat;
    opacity: 0.12;
    will-change: opacity;
    animation: twinkle 6s ease-in-out infinite alternate;
  }

  .stars i:nth-child(2) {
    animation-duration: 8s;
    animation-delay: -3s;
  }

  .stars i:nth-child(3) {
    animation-duration: 11s;
    animation-delay: -6s;
  }

  @keyframes twinkle {
    from {
      opacity: 0.08;
    }
    to {
      opacity: 0.75;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .stars i {
      animation: none;
      opacity: 0.35;
    }
  }
</style>
