---
import { site } from "../data/site";
const { links, turnstile } = site;
---

<section id="register" data-section="register" class="sec register-sec">
  <div class="wp m">▲ 04 · THE REGISTER</div>
  <h2>Sign <span class="serif">the register.</span></h2>
  <p class="sub">
    Hikers sign in at the trailhead so someone knows they passed through. Building something,
    hiring, or just want to say hi? Leave a note and I'll write back.
  </p>

  <div class="reg">
    <aside class="side" aria-label="Other ways to reach Ethan">
      <pre class="ascii m" aria-hidden="true">  ┌─────────────┐
  │  TRAIL      │
  │  REGISTER   │
  │  ─ ─ ─ ─ ─  │
  │  ─ ─ ─ ─    │
  └──────┬──────┘
         │
    ─────┴─────</pre>
      <span class="k m">OR FIND ME ON</span>
      <p class="alt m">
        <a href={links.x} target="_blank" rel="noopener">X ↗</a>
        <span class="sep" aria-hidden="true">·</span>
        <a href={links.linkedin} target="_blank" rel="noopener">LinkedIn ↗</a>
        <span class="sep" aria-hidden="true">·</span>
        <a href={links.github} target="_blank" rel="noopener">GitHub ↗</a>
      </p>
      <p class="note m">Usually replies within a couple of days.</p>
    </aside>

    <div class="register-card">
      <i class="corner tl" aria-hidden="true"></i>
      <i class="corner br" aria-hidden="true"></i>
      <form class="register-form" method="post" action="/api/send" novalidate>
        <input
          type="text"
          name="company"
          tabindex="-1"
          autocomplete="off"
          aria-hidden="true"
          class="hp"
        />
        <div class="hd m">
          <span>NEW ENTRY</span><span class="register-date" aria-live="polite"></span>
        </div>
        <div class="rows">
            <div class="register-row">
              <label class="m" for="register-name">NAME</label>
              <input
                id="register-name"
                name="name"
                placeholder="Who's passing through"
                required
                autocomplete="name"
              />
            </div>
            <div class="register-row">
              <label class="m" for="register-reply">REPLY TO</label>
              <input
                id="register-reply"
                name="email"
                type="email"
                placeholder="Where I can write back"
                required
                autocomplete="email"
              />
            </div>
            <div class="register-row">
              <label class="m" for="register-note">NOTE</label>
              <textarea
                id="register-note"
                name="message"
                placeholder="What are you working on?"
                required
                rows="3"></textarea>
            </div>
        </div>
        <div
          class="turnstile-slot"
          data-sitekey={turnstile.sitekey}
          data-action={turnstile.action}
        >
        </div>
        <div class="foot">
          <p class="fine m">Your address is only used to reply.</p>
          <button type="submit" class="register-submit btn m">Sign the register →</button>
        </div>
      </form>
      <p class="register-alert" role="alert" hidden></p>
      <div class="done" role="status" aria-live="polite" tabindex="-1">
        <div class="tick m">✓ SIGNED</div>
        <h3>Thanks for <span class="serif">stopping by.</span></h3>
        <p>Your note is on its way. I'll write back soon.</p>
        <pre class="m receipt" aria-hidden="true">note delivered
──────────────────────
safe travels ▲</pre>
      </div>
    </div>
  </div>
</section>

<style>
  .register-sec {
    position: relative;
    overflow: clip;
  }

  .reg {
    display: grid;
    grid-template-columns: 1fr 1.25fr;
    gap: 26px;
    margin-top: var(--space-waypoint-gap);
    align-items: start;
  }

  .ascii {
    font-size: var(--type-ascii);
    line-height: 1.3;
    color: var(--accent-gold);
    margin: 0 0 var(--space-tight);
  }

  .k {
    display: block;
    font-size: var(--type-label);
    letter-spacing: 0.14em;
    color: var(--text-muted);
    margin: var(--space-tight) 0 var(--space-chip-y);
  }

  .alt {
    margin: 0;
    font-size: var(--type-meta);
  }

  .alt a {
    color: var(--text-primary);
    text-decoration: none;
    border-bottom: var(--size-hairline) solid rgb(243 234 216 / 0.25);
    font-size: inherit;
  }

  .alt .sep {
    margin: 0 14px 0 0;
    color: var(--text-muted);
  }

  .note {
    font-size: var(--type-meta);
    color: var(--text-muted);
    margin-top: 14px;
  }

  .register-card {
    position: relative;
    background: rgb(243 234 216 / 0.035);
    border: var(--size-hairline) solid rgb(243 234 216 / 0.12);
    padding: var(--space-card-pad);
    backdrop-filter: blur(8px);
  }

  .corner {
    position: absolute;
    width: 10px;
    height: 10px;
    border-color: rgb(226 182 106 / 0.6);
    border-style: solid;
  }

  .tl {
    top: -1px;
    left: -1px;
    border-width: var(--size-hairline) 0 0 var(--size-hairline);
  }

  .br {
    bottom: -1px;
    right: -1px;
    border-width: 0 var(--size-hairline) var(--size-hairline) 0;
  }

  .hd {
    display: flex;
    justify-content: space-between;
    font-size: var(--type-label);
    letter-spacing: 0.14em;
    color: var(--text-muted);
    padding-bottom: 12px;
    border-bottom: var(--size-hairline) dashed var(--line-edge);
    margin-bottom: 6px;
  }

  .register-row {
    display: grid;
    grid-template-columns: 86px 1fr;
    align-items: baseline;
    gap: 12px;
    padding: 12px 0;
    border-bottom: var(--size-hairline) solid rgb(243 234 216 / 0.1);
  }

  .register-row label {
    font-size: var(--type-label);
    letter-spacing: 0.14em;
    color: var(--text-muted);
  }

  .register-row input,
  .register-row textarea {
    font: inherit;
    font-family: var(--font-sans);
    font-size: 14px;
    color: var(--text-primary);
    width: 100%;
    background: transparent;
    border: 0;
    outline: none;
    caret-color: var(--accent-gold);
    resize: vertical;
  }

  .register-row:focus-within {
    border-bottom-color: var(--accent-gold);
  }

  .register-row:focus-within label {
    color: var(--accent-gold);
  }

  @media (prefers-reduced-motion: no-preference) {
    .register-row {
      transition:
        border-bottom-color 0.15s ease,
        color 0.15s ease;
    }

    .register-row label {
      transition: color 0.15s ease;
    }
  }

  .register-row textarea {
    min-height: 66px;
    line-height: 1.55;
    white-space: pre-wrap;
  }

  .register-row input::placeholder,
  .register-row textarea::placeholder {
    color: #4c575e;
  }

  .hp {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .turnstile-slot {
    margin-top: var(--space-tight);
  }

  .foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: var(--space-tight);
    gap: 12px;
  }

  .fine {
    font-size: var(--type-label-sm);
    color: var(--text-muted);
    max-width: 200px;
    line-height: 1.45;
  }

  .btn {
    cursor: pointer;
    background: var(--accent-gold);
    color: var(--text-on-accent);
    font-family: var(--font-mono);
    font-size: var(--type-label);
    letter-spacing: 0.06em;
    padding: 11px 16px;
    border: 0;
    white-space: nowrap;
  }

  .btn:hover {
    background: #f0c77c;
  }

  .btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .register-alert {
    margin-top: var(--space-tight);
    color: var(--accent-fail);
    font-size: var(--type-meta);
  }

  .done {
    display: none;
    text-align: left;
    padding: 8px 0 4px;
  }

  .tick {
    color: var(--accent-gold);
    font-size: var(--type-label);
    letter-spacing: 0.14em;
  }

  .done h3 {
    color: var(--text-primary);
    font-size: var(--type-story-title);
    font-weight: 700;
    letter-spacing: -0.03em;
    margin: 10px 0 8px;
  }

  .done h3 .serif {
    font-size: var(--type-story-title-serif);
    color: var(--accent-gold);
  }

  .done p {
    color: var(--text-body);
    font-size: var(--type-meta);
  }

  .receipt {
    font-size: var(--type-label);
    color: var(--text-body);
    line-height: 1.7;
    margin-top: 12px;
  }

  .register-card.sent .register-form {
    display: none;
  }

  .register-card.sent .done {
    display: block;
  }

  @container site (max-width: 560px) {
    .reg {
      grid-template-columns: 1fr;
      gap: 18px;
    }

    .ascii {
      display: none;
    }

    .register-row {
      grid-template-columns: 1fr;
      gap: 4px;
    }

    .foot {
      flex-direction: column;
      align-items: stretch;
    }

    .btn {
      text-align: center;
    }
  }
</style>

<script>
  import { initRegister } from "../scripts/register.ts";
  const root = document.getElementById("register");
  if (root) initRegister(root);
</script>
